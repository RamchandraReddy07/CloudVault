{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2023",
        "outDir": "./dist",
        "rootDirs": [
            "src",
            "generated"
        ],
        "strict": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*",
        "generated/prisma/**/*"
    ]
}